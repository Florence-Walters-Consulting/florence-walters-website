# Production settings for the server. setup-server.sh creates /etc/fwc/web.env from this and
# fills DATABASE_URL and SESSION_SECRET for you. Edit the CHANGE_ME lines with: sudo nano /etc/fwc/web.env
# Put a value in "double quotes" if it contains spaces, & or #  (the discovery-call link usually needs them).
# Never commit the real file and never paste its secrets into chat or email.

# --- filled in automatically by setup-server.sh
DATABASE_URL=mysql://fwc:GENERATED@127.0.0.1:3306/florencewalters
SESSION_SECRET=GENERATED

# --- uploaded images live here (served by nginx under /site_img/)
LOCAL_UPLOAD_DIR=/var/lib/fwc/site_img

# --- reCAPTCHA (keys from the Google Cloud console; the secret is the "legacy" secret key)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=CHANGE_ME
RECAPTCHA_SECRET_KEY=CHANGE_ME
RECAPTCHA_ALLOWED_HOSTNAMES=florencewaltersconsulting.com,www.florencewaltersconsulting.com

# --- email: Microsoft 365 over SMTP (SMTP sending must be enabled for this mailbox)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@florencewaltersconsulting.com
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=info@florencewaltersconsulting.com
MAIL_TO=info@florencewaltersconsulting.com

# --- public company details (shown on the site; baked into the build)
NEXT_PUBLIC_COMPANY_NAME="Florence Walters Consulting"
NEXT_PUBLIC_COMPANY_PHONE=CHANGE_ME
NEXT_PUBLIC_COMPANY_EMAIL=info@florencewaltersconsulting.com
NEXT_PUBLIC_COMPANY_ADDRESS=CHANGE_ME
NEXT_PUBLIC_DISCOVERY_CALL_URL=CHANGE_ME
